<Window x:Class="TelemetryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Irufemi Telemetry Dashboard" Height="750" Width="600"
        Background="#0F111A"
        FontFamily="Segoe UI, Consolas, sans-serif">
    
    <!-- Window Style & Gradients -->
    <Window.Resources>
        <LinearGradientBrush x:Key="FpsAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6600FF9D" Offset="0.0" />
            <GradientStop Color="#0000FF9D" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CpuAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6600E5FF" Offset="0.0" />
            <GradientStop Color="#0000E5FF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GpuAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66FF3366" Offset="0.0" />
            <GradientStop Color="#00FF3366" Offset="1.0" />
        </LinearGradientBrush>
        
        <!-- Grid Background Brush -->
        <DrawingBrush x:Key="GridPattern" Viewport="0,0,40,40" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,40,40" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1AFFFFFF" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161925" Padding="20,15">
            <TextBlock Text="PERFORMANCE PROFILER" Foreground="#FFFFFF" FontSize="18" FontWeight="Light"/>
        </Border>

        <!-- Graph Area -->
        <Border Grid.Row="1" Background="#131620">
            <Grid>
                <!-- Background Grid -->
                <Border Background="{StaticResource GridPattern}" Margin="40,20,20,30" Opacity="0.5"/>
                
                <!-- Y-Axis Labels -->
                <Grid Margin="5,20,0,30" HorizontalAlignment="Left" Width="30">
                    <TextBlock Text="MAX" Foreground="#667085" VerticalAlignment="Top" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Text="MID" Foreground="#667085" VerticalAlignment="Center" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Text="0" Foreground="#667085" VerticalAlignment="Bottom" FontSize="10" TextAlignment="Right"/>
                </Grid>
                
                <!-- Graph Canvas -->
                <Canvas x:Name="GraphCanvas" Margin="40,20,20,30" ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged">
                    <!-- Area Polygons -->
                    <Polygon x:Name="FpsArea" Fill="{StaticResource FpsAreaBrush}" />
                    <Polygon x:Name="CpuArea" Fill="{StaticResource CpuAreaBrush}" />
                    <Polygon x:Name="GpuArea" Fill="{StaticResource GpuAreaBrush}" />
                    
                    <!-- Line Polylines -->
                    <Polyline x:Name="FpsLine" Stroke="#00FF9D" StrokeThickness="2">
                        <Polyline.Effect>
                            <DropShadowEffect Color="#00FF9D" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                        </Polyline.Effect>
                    </Polyline>
                    <Polyline x:Name="CpuLine" Stroke="#00E5FF" StrokeThickness="2">
                        <Polyline.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                        </Polyline.Effect>
                    </Polyline>
                    <Polyline x:Name="GpuLine" Stroke="#FF3366" StrokeThickness="2">
                        <Polyline.Effect>
                            <DropShadowEffect Color="#FF3366" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                        </Polyline.Effect>
                    </Polyline>
                </Canvas>
                
                <!-- Graph Legend -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <TextBlock Foreground="#00FF9D" Text="■ FPS (Max: 120)" Margin="0,0,20,0" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Foreground="#00E5FF" Text="■ CPU (Max: 33.3ms)" Margin="0,0,20,0" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Foreground="#FF3366" Text="■ GPU (Max: 33.3ms)" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Divider -->
        <Border Grid.Row="2" Background="#1E2233" />

        <!-- Data List -->
        <ScrollViewer Grid.Row="3" Margin="0,10,0,0">
            <ItemsControl x:Name="MetricsList" Margin="20">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" Margin="0,15,0,10" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card Style -->
                        <Border Background="#1A1D2C" CornerRadius="8" Margin="0,0,15,15" Padding="15,10" Width="250" BorderBrush="#2A2F45" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#8A92B2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="{Binding StatusColorBrush}" FontSize="20" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Divider -->
        <Border Grid.Row="4" Background="#1E2233" />

        <!-- Remote Command Console -->
        <Border Grid.Row="5" Background="#141724" Padding="15,12" BorderBrush="#2A2F45" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionLed" Width="8" Height="8" Fill="#667085" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="REMOTE COMMAND CONSOLE (TCP : 8889)" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CommandStatusText" Text="Waiting for Game (127.0.0.1:8889)..." Foreground="#8A92B2" FontSize="11" HorizontalAlignment="Right" FontFamily="Consolas" VerticalAlignment="Center"/>
                </Grid>

                <!-- Quick Action Buttons -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="💥 10,000 Debris" Click="Button_Spawn10k_Click" Background="#26304D" Foreground="#00FF9D" BorderBrush="#00FF9D" BorderThickness="1" Padding="10,6" Margin="0,0,8,6" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                    <Button Content="📦 1,000 Debris" Click="Button_Spawn1k_Click" Background="#1F2538" Foreground="#E2E8F0" BorderBrush="#3B4261" BorderThickness="1" Padding="10,6" Margin="0,0,8,6" Cursor="Hand" FontSize="12"/>
                    <Button Content="🧹 Clear Debris" Click="Button_ClearDebris_Click" Background="#1F2538" Foreground="#FF8A8A" BorderBrush="#52303A" BorderThickness="1" Padding="10,6" Margin="0,0,8,6" Cursor="Hand" FontSize="12"/>
                </WrapPanel>

                <!-- Command Input Box -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandInputTextBox" Background="#0A0C14" Foreground="#FFFFFF" BorderBrush="#2A2F45" BorderThickness="1" Padding="10,6" FontSize="13" FontFamily="Consolas" VerticalContentAlignment="Center" KeyDown="CommandInputTextBox_KeyDown" CaretBrush="#00FF9D"/>
                    <Button Grid.Column="1" Content="Send" Click="SendCommandButton_Click" Background="#00E5FF" Foreground="#0A0C14" FontWeight="Bold" Padding="16,6" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
